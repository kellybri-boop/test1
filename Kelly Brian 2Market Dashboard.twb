            </view>
            <mark class='Line' />
            <encodings>
              <lod column='[federated.1dzfbvi18i14hw15t54e21x26ewi].[sum:Kidhome:qk]' />
              <lod column='[federated.1dzfbvi18i14hw15t54e21x26ewi].[sum:Teenhome:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.1dzfbvi18i14hw15t54e21x26ewi].[sum:Calculation_0415390959607815:qk] + [federated.1dzfbvi18i14hw15t54e21x26ewi].[avg:Income:qk])</rows>
        <cols>[federated.1dzfbvi18i14hw15t54e21x26ewi].[none:Year Birth (bin):ok]</cols>
