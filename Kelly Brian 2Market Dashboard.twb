    <worksheet name='Spend Income Geography Patterns'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Spend and Income Patterns Across Countries</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing_data.csv+ (Multiple Connections)' name='federated.1dzfbvi18i14hw15t54e21x26ewi' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1dzfbvi18i14hw15t54e21x26ewi'>
            <column caption='Total Chocolates' datatype='integer' name='[AmtChocolates]' role='measure' type='quantitative' />
            <column caption='Total Commodoties' datatype='integer' name='[AmtComm]' role='measure' type='quantitative' />
            <column caption='Total Alcohol' datatype='integer' name='[AmtLiq]' role='measure' type='quantitative' />
            <column caption='Total Non Veg' datatype='integer' name='[AmtNonVeg]' role='measure' type='quantitative' />
            <column caption='Total Fish' datatype='integer' name='[AmtPes]' role='measure' type='quantitative' />
            <column caption='Total Veg' datatype='integer' name='[AmtVege]' role='measure' type='quantitative' />
            <column caption='Total Spend' datatype='integer' name='[Calculation_0415390959607815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AmtLiq]+[AmtChocolates]+[AmtComm]+[AmtPes]+[AmtPes]+[AmtNonVeg]+[AmtVege]' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;SP&quot;' value='&quot;Spain&quot;' />
              </semantic-values>
            </column>
            <column datatype='real' name='[Income]' role='measure' type='quantitative' />
