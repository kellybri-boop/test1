            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Marital_Status:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Marital_Status:nk]' member='%null%' />
                <groupfilter function='member' level='[none:Marital_Status:nk]' member='&quot;Absurd&quot;' />
                <groupfilter function='member' level='[none:Marital_Status:nk]' member='&quot;YOLO&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <manual-sort column='[federated.1dzfbvi18i14hw15t54e21x26ewi].[none:Marital_Status:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Alone&quot;</bucket>
              <bucket>&quot;Absurd&quot;</bucket>
              <bucket>&quot;Divorced&quot;</bucket>
              <bucket>&quot;Married&quot;</bucket>
              <bucket>&quot;Single&quot;</bucket>
              <bucket>&quot;Together&quot;</bucket>
              <bucket>&quot;Widow&quot;</bucket>
              <bucket>&quot;YOLO&quot;</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.1dzfbvi18i14hw15t54e21x26ewi].[none:Marital_Status:nk]</column>
          </slices>
