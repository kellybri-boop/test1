    <worksheet name='Age Total Spend and Average Income'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Age to Total Spend and Average Income</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing_data.csv+ (Multiple Connections)' name='federated.1dzfbvi18i14hw15t54e21x26ewi' />
          </datasources>
          <datasource-dependencies datasource='federated.1dzfbvi18i14hw15t54e21x26ewi'>
            <column caption='Total Chocolates' datatype='integer' name='[AmtChocolates]' role='measure' type='quantitative' />
            <column caption='Total Commodoties' datatype='integer' name='[AmtComm]' role='measure' type='quantitative' />
            <column caption='Total Alcohol' datatype='integer' name='[AmtLiq]' role='measure' type='quantitative' />
            <column caption='Total Non Veg' datatype='integer' name='[AmtNonVeg]' role='measure' type='quantitative' />
            <column caption='Total Fish' datatype='integer' name='[AmtPes]' role='measure' type='quantitative' />
            <column caption='Total Veg' datatype='integer' name='[AmtVege]' role='measure' type='quantitative' />
            <column caption='Total Spend' datatype='integer' name='[Calculation_0415390959607815]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[AmtLiq]+[AmtChocolates]+[AmtComm]+[AmtPes]+[AmtPes]+[AmtNonVeg]+[AmtVege]' />
            </column>
            <column datatype='real' name='[Income]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Kidhome]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Teenhome]' role='measure' type='quantitative' />
            <column aggregation='None' caption='Year Birth (Bin SIZE 8)' datatype='integer' name='[Year Birth (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Year_Birth]' peg='0' size='8' />
            </column>
            <column caption='Year Birth' datatype='integer' name='[Year_Birth]' role='dimension' type='quantitative' />
            <column-instance column='[Income]' derivation='Avg' name='[avg:Income:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Year Birth (bin)]' derivation='None' name='[none:Year Birth (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0415390959607815]' derivation='Sum' name='[sum:Calculation_0415390959607815:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Kidhome]' derivation='Sum' name='[sum:Kidhome:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Teenhome]' derivation='Sum' name='[sum:Teenhome:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.1dzfbvi18i14hw15t54e21x26ewi].[sum:Calculation_0415390959607815:qk]'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
          <pane id='2' selection-relaxation-option='selection-relaxation-allow' y-axis-name='[federated.1dzfbvi18i14hw15t54e21x26ewi].[avg:Income:qk]'>
            <view>
