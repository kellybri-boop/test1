    <worksheet name='Channel as Percentage of Successful Lead Conversions'>
      <table>
        <view>
          <datasources>
            <datasource caption='marketing_data.csv+ (Multiple Connections)' name='federated.1dzfbvi18i14hw15t54e21x26ewi' />
          </datasources>
          <datasource-dependencies datasource='federated.1dzfbvi18i14hw15t54e21x26ewi'>
            <column caption='Brochure ad' datatype='integer' name='[Brochure_ad]' role='measure' type='quantitative' />
            <column caption='Bulkmail ad' datatype='integer' name='[Bulkmail_ad]' role='measure' type='quantitative' />
            <column caption='Total Mail Success' datatype='integer' name='[Calculation_0180095596806144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([Bulkmail_ad])' />
            </column>
            <column caption='Total Facebook Sucess' datatype='integer' name='[Calculation_0180095597137921]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='Sum([Facebook_ad])' />
            </column>
            <column caption='Total Add Sucess' datatype='integer' name='[Calculation_0904673326772224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Brochure_ad])+SUM([Bulkmail_ad])+sum([Facebook_ad])+sum([Instagram_ad])+SUM([Twitter_ad])' />
            </column>
            <column caption='Total Brochure Success' datatype='integer' name='[Calculation_0904673329164289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM ([Brochure_ad])' />
            </column>
            <column caption='Total Sucessful Ads' datatype='integer' name='[Calculation_0904673736228866]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Brochure_ad]=1)+COUNT([Bulkmail_ad]=1)+COUNT([Facebook_ad]=1)+COUNT([Instagram_ad]=1)+COUNT([Twitter_ad]=1)' />
            </column>
            <column caption='Brochure Success as % of Total Success' datatype='real' name='[Calculation_0904673737879555]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Brochure_ad])/[Calculation_0904673326772224]' />
            </column>
            <column caption='Bulkmail Success % of Total Success' datatype='real' name='[Calculation_0904673745506309]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Bulkmail_ad])/[Calculation_0904673326772224]' />
            </column>
            <column caption='Facebook Sucess % of Total' datatype='real' name='[Calculation_0904673745989638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Facebook_ad])/[Calculation_0904673326772224]' />
            </column>
            <column caption='Instagram Sucess % of Total Sucess' datatype='real' name='[Calculation_0904673747951623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Instagram_ad])/[Calculation_0904673326772224]' />
            </column>
            <column caption='Twitter Sucess % of Total Sucess' datatype='real' name='[Calculation_0904673748172808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Twitter_ad])/[Calculation_0904673326772224]' />
            </column>
            <column caption='Facebook ad' datatype='integer' name='[Facebook_ad]' role='measure' type='quantitative' />
            <column caption='Instagram ad' datatype='integer' name='[Instagram_ad]' role='measure' type='quantitative' />
            <column caption='Twitter ad' datatype='integer' name='[Twitter_ad]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0180095596806144]' derivation='User' name='[usr:Calculation_0180095596806144:qk]' pivot='key' type='quantitative' />
